# Copy to .env and fill in your own values. Never commit .env. Placeholders only.
NODE_ENV=development
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/citydesk   # unset = PGLite
PGLITE_PATH=./.data/pglite
BETTER_AUTH_SECRET=change-me-random-32-bytes
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080
VITE_AUTH_ENABLED=true
VITE_PUBLIC_HOSTNAME=localhost
GROK_GATE_ORIGIN=
GROK_PROJECT_ID=
# Preview OAuth (sandbox only; leave empty for local OSS clones)
GROK_PREVIEW_CLIENT_ID=grok_preview
GROK_PREVIEW_CLIENT_SECRET=
CARTO_TOKEN=
VALHALLA_URL=
OVERPASS_LOCAL_URL=
VITE_STUN_URLS=stun:stun.l.google.com:19302
# Property desk (off by default)
PROPERTY_ENABLED=false
PROPERTY_MINT_ENABLED=false
PROPERTY_KEK=generate-locally-never-commit
PROPERTY_KEK_ID=dev-1
PROPERTY_EVIDENCE_DIR=./.data/evidence
# Chain: devnet only. No private keys anywhere in env.
SOLANA_CLUSTER=devnet
NEURA_WEBHOOK_SECRET=
# Scans / ingest
SCAN_STORAGE_DIR=./.data/scans
SCAN_PIPELINE=off
INGEST_SCAM_FLAG=true
INGEST_SCAM_HOLD=false
INSPECT_ENABLED=false
# Feature flags
VITE_NDU_IMMERSE=false
VITE_NDU_GROUND=false
VITE_NDU_ASSISTANT=false
VITE_REGISTRY_URL=
